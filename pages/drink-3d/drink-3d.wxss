.page{height:100vh;background:#07090d;color:#f7f2e8;position:relative;overflow:hidden}.scene-shell{position:absolute;inset:0 0 250rpx 0;background:#07090d}.webgl{width:100%;height:100%;display:block}.loading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#080b10;color:#8c94a3;font-size:24rpx;z-index:6}.hud-overlay{position:absolute;left:0;right:0;top:0;z-index:4;display:flex;justify-content:space-between;align-items:flex-start;padding:calc(24rpx + env(safe-area-inset-top)) 30rpx 16rpx;background:linear-gradient(180deg,rgba(4,6,10,.86) 0%,rgba(4,6,10,.38) 56%,rgba(4,6,10,0) 100%);pointer-events:none}.hud-left{display:flex;flex-direction:column}.eyebrow{font-size:17rpx;letter-spacing:3rpx;color:#8d95a3}.title{font-size:42rpx;font-weight:800;margin-top:8rpx;text-shadow:0 4rpx 18rpx rgba(0,0,0,.55)}.sub{font-size:21rpx;color:#a4aab5;margin-top:4rpx}.meter-wrap{text-align:right;display:flex;flex-direction:column;padding-top:4rpx}.meter-value{font-size:42rpx;font-weight:800;text-shadow:0 4rpx 18rpx rgba(0,0,0,.55)}.meter-label{font-size:20rpx;color:#a2a8b2}.quote{position:absolute;left:50%;bottom:88rpx;z-index:5;max-width:78%;transform:translate(-50%,12rpx);padding:14rpx 26rpx;border-radius:999rpx;background:rgba(8,10,15,.68);border:1rpx solid rgba(255,255,255,.10);box-shadow:0 10rpx 36rpx rgba(0,0,0,.28);font-size:23rpx;color:#eee3d3;text-align:center;opacity:0;transition:all .25s ease;pointer-events:none}.quote.show{opacity:1;transform:translate(-50%,0)}.drag-tip{position:absolute;right:24rpx;bottom:24rpx;z-index:4;padding:8rpx 14rpx;border-radius:999rpx;background:rgba(0,0,0,.32);font-size:17rpx;color:rgba(255,255,255,.48);pointer-events:none}.control-dock{position:absolute;left:0;right:0;bottom:0;z-index:8;min-height:250rpx;background:linear-gradient(180deg,rgba(10,12,17,.76),rgba(8,10,14,.98) 30%);border-top:1rpx solid rgba(255,255,255,.08);box-shadow:0 -20rpx 50rpx rgba(0,0,0,.28);padding-bottom:env(safe-area-inset-bottom)}.action-row{display:flex;align-items:center;gap:12rpx;padding:20rpx 22rpx 10rpx}.primary,.secondary{height:94rpx;border-radius:28rpx;font-size:28rpx;font-weight:750;line-height:94rpx;padding:0 24rpx}.primary{background:linear-gradient(135deg,#efb15d,#c77531);color:#160f08;flex:1;box-shadow:0 10rpx 30rpx rgba(211,126,47,.24)}.secondary{background:rgba(255,255,255,.07);color:#f1e9dc;border:1rpx solid rgba(255,255,255,.12);flex:1}.primary::after,.secondary::after{border:0}.primary[disabled],.secondary[disabled]{opacity:.42}.mini-stat{width:66rpx;text-align:center;display:flex;flex-direction:column;font-size:17rpx;color:#777f8c}.mini-stat .num{font-size:32rpx;color:#f2e5d1;font-weight:700}.dock-tools{height:72rpx;display:flex;align-items:center;justify-content:space-between;padding:0 30rpx 10rpx}.cabinet-toggle{display:flex;align-items:center;gap:10rpx;color:#b9b0a2;font-size:22rpx}.chev{color:#e4a95d}.finish{font-size:20rpx;color:#646d79;padding:12rpx}.drawer{height:154rpx;border-top:1rpx solid rgba(255,255,255,.06);padding-top:12rpx}.scroll{width:100%;white-space:nowrap}.list{display:flex;gap:12rpx;padding:0 22rpx 14rpx}.card{width:126rpx;height:122rpx;border-radius:22rpx;background:rgba(255,255,255,.045);border:1rpx solid rgba(255,255,255,.08);display:flex;flex-direction:column;align-items:center;justify-content:center;flex-shrink:0}.card.active{background:rgba(231,166,77,.14);border-color:rgba(231,166,77,.68);transform:translateY(-2rpx)}.emoji{font-size:34rpx}.name{font-size:20rpx;margin-top:4rpx}.abv{font-size:17rpx;color:#747d8a}
