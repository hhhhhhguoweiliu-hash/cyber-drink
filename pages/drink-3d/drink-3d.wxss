.page{min-height:100vh;background:#080a10;color:#f7f2e8;display:flex;flex-direction:column;overflow:hidden}.hud{display:flex;justify-content:space-between;align-items:flex-end;padding:26rpx 30rpx 16rpx}.hud-left{display:flex;flex-direction:column}.eyebrow{font-size:18rpx;letter-spacing:4rpx;color:#7f8795}.title{font-size:42rpx;font-weight:800;margin-top:6rpx}.sub{font-size:22rpx;color:#9298a6;margin-top:4rpx}.meter-wrap{text-align:right;display:flex;flex-direction:column}.meter-value{font-size:42rpx;font-weight:800}.meter-label{font-size:20rpx;color:#8f96a3}.quote{height:52rpx;opacity:0;text-align:center;font-size:24rpx;color:#d8d0c2;transition:opacity .25s ease}.quote.show{opacity:1}.scene-shell{height:720rpx;margin:0 18rpx;position:relative;border-radius:32rpx;overflow:hidden;border:1rpx solid rgba(255,255,255,.08);box-shadow:0 24rpx 80rpx rgba(0,0,0,.48)}.webgl{width:100%;height:100%;display:block}.loading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#0a0d14;color:#8c94a3;font-size:24rpx}.actions{display:flex;align-items:center;gap:14rpx;padding:18rpx 24rpx 12rpx}.primary,.secondary{height:92rpx;border-radius:26rpx;font-size:28rpx;font-weight:700;line-height:92rpx;padding:0 30rpx}.primary{background:linear-gradient(135deg,#e7a64d,#c9732e);color:#160f08;flex:1}.secondary{background:rgba(255,255,255,.08);color:#f1e9dc;border:1rpx solid rgba(255,255,255,.12);flex:1}.primary::after,.secondary::after{border:0}.primary[disabled],.secondary[disabled]{opacity:.42}.mini-stat{width:70rpx;text-align:center;display:flex;flex-direction:column;font-size:18rpx;color:#777f8c}.mini-stat .num{font-size:32rpx;color:#f2e5d1;font-weight:700}.drawer{padding:4rpx 0 0}.drawer-head{display:flex;justify-content:space-between;padding:0 30rpx 12rpx;font-size:22rpx;color:#b8bdc6}.drawer-head .hint{font-size:18rpx;color:#666f7d}.scroll{width:100%;white-space:nowrap}.list{display:flex;gap:14rpx;padding:0 24rpx 16rpx}.card{width:132rpx;height:116rpx;border-radius:22rpx;background:rgba(255,255,255,.045);border:1rpx solid rgba(255,255,255,.08);display:flex;flex-direction:column;align-items:center;justify-content:center;flex-shrink:0}.card.active{background:rgba(231,166,77,.13);border-color:rgba(231,166,77,.65);transform:translateY(-3rpx)}.emoji{font-size:34rpx}.name{font-size:20rpx;margin-top:4rpx}.abv{font-size:17rpx;color:#747d8a}.footer{padding:0 28rpx calc(14rpx + env(safe-area-inset-bottom));text-align:center}.finish{font-size:20rpx;color:#626a77;padding:8rpx}
