/* pages/result/result.wxss - 结算页面样式 */
.result-page {
  min-height: 100vh;
  padding: 40rpx 32rpx;
  padding-bottom: 120rpx;
}

/* 头部结果 */
.result-header {
  text-align: center;
  padding: 40rpx 0;
}

.result-emoji {
  display: block;
  font-size: 96rpx;
  margin-bottom: 20rpx;
  filter: drop-shadow(0 4rpx 16rpx rgba(239, 159, 39, 0.3));
  animation: emojiBounce 0.6s ease-out;
}

@keyframes emojiBounce {
  0% { transform: scale(0.5); opacity: 0; }
  60% { transform: scale(1.15); }
  100% { transform: scale(1); opacity: 1; }
}

.result-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
}

.result-subtitle {
  display: block;
  font-size: 28rpx;
  color: #888;
  margin-top: 12rpx;
}

/* 战绩数据网格 */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin: 32rpx 0;
}

.stat-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #EF9F27;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #888;
  margin-top: 8rpx;
}

/* 评价卡片 */
.verdict-card {
  background: linear-gradient(135deg, rgba(239, 159, 39, 0.1), rgba(216, 90, 48, 0.05));
  border: 1rpx solid rgba(239, 159, 39, 0.2);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin: 24rpx 0;
  text-align: center;
  box-shadow: 0 0 24rpx rgba(239, 159, 39, 0.08);
}

.verdict-text {
  font-size: 28rpx;
  color: #EF9F27;
  line-height: 1.6;
}

/* 成就区域 */
.achievement-section {
  margin: 32rpx 0;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #e0e0e0;
  margin-bottom: 20rpx;
}

.ach-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ach-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, rgba(93, 202, 165, 0.1), rgba(93, 202, 165, 0.03));
  border-radius: 16rpx;
  border: 1rpx solid rgba(93, 202, 165, 0.2);
  box-shadow: 0 0 16rpx rgba(93, 202, 165, 0.06);
  animation: fadeIn 0.4s ease-out;
}

.ach-emoji {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.ach-info {
  flex: 1;
}

.ach-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #5DCAA5;
}

.ach-desc {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-top: 4rpx;
}

/* 累计统计 */
.total-stats {
  margin: 32rpx 0;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.total-label {
  font-size: 26rpx;
  color: #aaa;
}

.total-num {
  font-size: 30rpx;
  font-weight: 600;
  color: #e0e0e0;
}

/* 按钮区 */
.result-actions {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-share {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #5DCAA5, #1D9E75);
  border: none;
  border-radius: 44rpx;
}

.btn-share::after {
  border: none;
}

.btn-row {
  display: flex;
  gap: 20rpx;
}

.btn-again {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
  background: linear-gradient(135deg, #EF9F27, #D85A30);
  border: none;
  border-radius: 40rpx;
}

.btn-again::after {
  border: none;
}

.btn-home {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: #aaa;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 40rpx;
}

.btn-home::after {
  border: none;
}
