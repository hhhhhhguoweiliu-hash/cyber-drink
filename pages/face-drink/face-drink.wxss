/* pages/face-drink/face-drink.wxss - 面基喝酒样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0f0f1e 0%, #1a1525 40%, #0f0f1e 100%);
  padding-bottom: 40rpx;
}

/* ==================== 头部 ==================== */
.header {
  text-align: center;
  padding: 40rpx 40rpx 20rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #e8d5b0;
  letter-spacing: 4rpx;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
}

/* ==================== 选酒区 ==================== */
.drink-select {
  padding: 0 40rpx;
  margin-bottom: 30rpx;
}

.select-label {
  display: block;
  font-size: 26rpx;
  color: #aaa;
  margin-bottom: 16rpx;
}

.drink-scroll {
  white-space: nowrap;
  width: 100%;
}

.drink-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  margin-right: 16rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.drink-chip.active {
  background: rgba(239, 159, 39, 0.1);
  border-color: #EF9F27;
}

.chip-emoji {
  font-size: 36rpx;
}

.chip-name {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 4rpx;
}

/* ==================== 隐私说明 ==================== */
.privacy-notice {
  display: flex;
  align-items: flex-start;
  background: rgba(93, 202, 165, 0.08);
  border: 1rpx solid rgba(93, 202, 165, 0.25);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
  gap: 12rpx;
}

.privacy-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.privacy-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.privacy-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #5DCAA5;
  margin-bottom: 6rpx;
}

.privacy-text {
  font-size: 22rpx;
  color: #7ab8a0;
  line-height: 1.5;
}

.privacy-close {
  font-size: 28rpx;
  color: #5a6878;
  padding: 4rpx 8rpx;
  flex-shrink: 0;
}

.privacy-mini {
  text-align: center;
  padding: 0 40rpx;
  margin-bottom: 20rpx;
}

.privacy-mini text {
  font-size: 22rpx;
  color: #5a6878;
}

/* ==================== 上传区 ==================== */
.upload-zone {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: 0 40rpx;
}

.upload-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.player-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.avatar-box {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.06);
  border: 3rpx dashed rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.avatar-box:active {
  transform: scale(0.95);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.placeholder-emoji {
  font-size: 48rpx;
}

.placeholder-text {
  font-size: 22rpx;
  color: #666;
  margin-top: 8rpx;
}

.player-name {
  font-size: 26rpx;
  color: #888;
  margin-top: 12rpx;
}

/* VS 分割行 */
.upload-vs-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 30rpx;
  padding: 20rpx 0;
}

.vs-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
}

.vs-text {
  font-size: 40rpx;
  font-weight: 800;
  color: #EF9F27;
  text-shadow: 0 0 20rpx rgba(239, 159, 39, 0.3);
}

/* ==================== 开始按钮 ==================== */
.start-zone {
  padding: 20rpx 40rpx;
}

.start-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #EF9F27, #D85A30);
  border: none;
  border-radius: 48rpx;
}

.start-btn::after {
  border: none;
}

.start-btn[disabled] {
  background: rgba(255, 255, 255, 0.1);
  color: #555;
}

/* ==================== 游戏区域 ==================== */
.game-area {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 20rpx 16rpx;
  position: relative;
}

.player-side {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  max-width: 300rpx;
  transition: all 0.3s ease;
}

.player-side.passed-out {
  opacity: 0.5;
  filter: grayscale(0.6);
}

.left-side {
  align-items: center;
}

.right-side {
  align-items: center;
}

.player-avatar-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  overflow: visible;
}

/* 头像本身裁切（canvas 绘制脸部动画） */
.game-avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.15);
  display: block;
  transform-origin: center center;
  overflow: hidden;
}

.drunk-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(180, 50, 50, 1);
  mix-blend-mode: multiply;
  pointer-events: none;
  transition: opacity 0.5s ease;
}

/* ==================== 叫爸爸气泡 ==================== */
.daddy-bubble {
  position: absolute;
  top: -44rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #fff;
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  z-index: 11;
  white-space: nowrap;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.35);
  animation: daddyPop 0.35s ease-out;
}

/* 气泡小尾巴 */
.daddy-bubble::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid #fff;
}

.daddy-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #D85A30;
}

@keyframes daddyPop {
  0% { transform: translateX(-50%) scale(0.3); opacity: 0; }
  60% { transform: translateX(-50%) scale(1.15); opacity: 1; }
  100% { transform: translateX(-50%) scale(1); opacity: 1; }
}

/* ==================== 窘态 emoji 弹窗 ==================== */
.drunk-emoji-pop {
  position: absolute;
  top: -20rpx;
  right: -15rpx;
  z-index: 10;
  animation: emojiFloat 2s ease-in-out infinite;
}

.emoji-pop-text {
  font-size: 40rpx;
  filter: drop-shadow(0 2rpx 6rpx rgba(0, 0, 0, 0.4));
}

@keyframes emojiFloat {
  0% { transform: translateY(0) scale(1); opacity: 1; }
  50% { transform: translateY(-10rpx) scale(1.15); opacity: 0.9; }
  100% { transform: translateY(0) scale(1); opacity: 1; }
}

/* ==================== 窘态描述文字 ==================== */
.reaction-text {
  font-size: 20rpx;
  color: #D85A30;
  margin-top: 6rpx;
  text-align: center;
  max-width: 260rpx;
  line-height: 1.4;
  animation: reactionPop 0.4s ease-out;
  background: rgba(216, 90, 48, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

@keyframes reactionPop {
  0% { transform: scale(0.6); opacity: 0; }
  60% { transform: scale(1.1); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

.player-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #e0e0e0;
  margin-top: 8rpx;
}

.drunk-meter {
  width: 160rpx;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 6rpx;
  margin-top: 8rpx;
  overflow: hidden;
}

.meter-bar {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.4s ease, background 0.3s ease;
}

.drunk-status {
  font-size: 22rpx;
  color: #888;
  margin-top: 6rpx;
}

/* CSS 酒杯 */
.my-glass,
.friend-glass {
  margin-top: 16rpx;
}

.glass-cup {
  position: relative;
  width: 80rpx;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 0 0 40rpx 40rpx;
  overflow: hidden;
}

.glass-liquid {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--glass-color, rgba(250, 199, 117, 0.78));
  transition: height 0.4s ease;
}

.player-quote {
  font-size: 22rpx;
  color: #EF9F27;
  margin-top: 12rpx;
  text-align: center;
  max-width: 260rpx;
  line-height: 1.5;
  animation: quotePop 0.3s ease-out;
}

@keyframes quotePop {
  0% { transform: scale(0.8); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

/* ==================== 中间干杯区 ==================== */
.center-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 40rpx;
}

.cheers-zone {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
}

.cheers-emoji {
  font-size: 64rpx;
  filter: drop-shadow(0 0 12rpx rgba(239, 159, 39, 0.3));
  transition: transform 0.2s ease;
}

.cheer-bounce {
  animation: cheerBounce 0.4s ease-out;
}

@keyframes cheerBounce {
  0% { transform: scale(1) rotate(0deg); }
  30% { transform: scale(1.3) rotate(-10deg); }
  60% { transform: scale(1.1) rotate(10deg); }
  100% { transform: scale(1) rotate(0deg); }
}

.cheers-text {
  font-size: 24rpx;
  color: #EF9F27;
  margin-top: 8rpx;
}

.round-text {
  font-size: 22rpx;
  color: #555;
  margin-top: 16rpx;
}

/* ==================== 照片窘态动画 ==================== */

/* 微醺：轻微摇晃 */
.anim-tipsy {
  animation: animTipsy 3s ease-in-out infinite;
}

@keyframes animTipsy {
  0%, 100% { transform: rotate(0deg) translateX(0); }
  25% { transform: rotate(2deg) translateX(3rpx); }
  75% { transform: rotate(-2deg) translateX(-3rpx); }
}

/* 上头了：明显晃动 + 轻微旋转 */
.anim-buzzed {
  animation: animBuzzed 1.5s ease-in-out infinite;
}

@keyframes animBuzzed {
  0%, 100% { transform: rotate(0deg) translate(0, 0); }
  20% { transform: rotate(4deg) translate(4rpx, -2rpx); }
  40% { transform: rotate(-3deg) translate(-4rpx, 2rpx); }
  60% { transform: rotate(3deg) translate(3rpx, -1rpx); }
  80% { transform: rotate(-2deg) translate(-3rpx, 1rpx); }
}

/* 醉了：剧烈抖动 + 模糊 + 脸红 */
.anim-drunk {
  animation: animDrunk 0.6s ease-in-out infinite;
  filter: blur(1.5rpx) saturate(1.3);
}

@keyframes animDrunk {
  0%, 100% { transform: rotate(0deg) translate(0, 0) scale(1); }
  15% { transform: rotate(5deg) translate(5rpx, -3rpx) scale(1.02); }
  30% { transform: rotate(-4deg) translate(-5rpx, 3rpx) scale(0.98); }
  45% { transform: rotate(3deg) translate(4rpx, -2rpx) scale(1.01); }
  60% { transform: rotate(-3deg) translate(-4rpx, 2rpx) scale(0.99); }
  75% { transform: rotate(2deg) translate(2rpx, -1rpx) scale(1); }
}

/* 断片边缘：旋转 + 严重模糊 + 重影 */
.anim-blackout-edge {
  animation: animBlackoutEdge 1.2s ease-in-out infinite;
  filter: blur(3rpx) saturate(0.6) brightness(0.8);
}

@keyframes animBlackoutEdge {
  0% { transform: rotate(0deg) scale(1); }
  25% { transform: rotate(8deg) scale(1.05) translateX(6rpx); }
  50% { transform: rotate(-6deg) scale(0.95) translateX(-6rpx); }
  75% { transform: rotate(4deg) scale(1.03) translateX(3rpx); }
  100% { transform: rotate(0deg) scale(1); }
}

/* 已断片：完全扭曲 + 黑白 + 倾倒 */
.anim-blackout {
  animation: animBlackout 2s ease-in-out infinite;
  filter: blur(4rpx) grayscale(0.5) brightness(0.5);
}

@keyframes animBlackout {
  0%, 100% { transform: rotate(-15deg) translateY(10rpx) scale(0.9); }
  50% { transform: rotate(-12deg) translateY(8rpx) scale(0.88); }
}

/* ==================== 屏幕特效 ==================== */
.screen-shake {
  animation: screenShake 0.15s ease-in-out infinite;
}

@keyframes screenShake {
  0%, 100% { transform: translateX(0) translateY(0); }
  25% { transform: translateX(-3rpx) translateY(2rpx); }
  50% { transform: translateX(2rpx) translateY(-3rpx); }
  75% { transform: translateX(-2rpx) translateY(1rpx); }
}

.blackout-anim {
  animation: blackoutFade 2s ease-out forwards;
}

@keyframes blackoutFade {
  0% { filter: brightness(1); }
  100% { filter: brightness(0.2); }
}

/* ==================== 结束弹窗 ==================== */
.result-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.result-card {
  width: 560rpx;
  padding: 48rpx 40rpx;
  background: linear-gradient(180deg, #1a1525, #0f0f1e);
  border-radius: 32rpx;
  border: 1rpx solid rgba(239, 159, 39, 0.2);
  text-align: center;
  animation: cardPop 0.4s ease-out;
}

@keyframes cardPop {
  0% { transform: scale(0.8); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.result-emoji {
  font-size: 80rpx;
}

.result-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #e8d5b0;
  margin-top: 16rpx;
}

.result-desc {
  display: block;
  font-size: 26rpx;
  color: #888;
  margin-top: 8rpx;
}

.result-stats {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin: 24rpx 0;
}

.rs-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.rs-label {
  font-size: 22rpx;
  color: #666;
}

.rs-value {
  font-size: 28rpx;
  color: #EF9F27;
  margin-top: 4rpx;
}

/* 隐私提醒 */
.result-privacy {
  margin: 16rpx 0;
  padding: 12rpx 20rpx;
  background: rgba(93, 202, 165, 0.08);
  border-radius: 12rpx;
}

.result-privacy text {
  font-size: 22rpx;
  color: #5DCAA5;
}

.result-btn {
  margin-top: 8rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #EF9F27, #D85A30);
  border: none;
  border-radius: 44rpx;
}

.result-btn::after {
  border: none;
}

.result-home {
  margin-top: 16rpx;
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  color: #ccc;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 44rpx;
}

.result-home::after {
  border: none;
}

.result-share {
  margin-top: 16rpx;
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: #888;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 44rpx;
}

.result-share::after {
  border: none;
}
