.page{min-height:100vh;background:#080a10;color:#f4eee4;display:flex;flex-direction:column}.head{padding:28rpx 30rpx 18rpx;display:flex;flex-direction:column}.eyebrow{font-size:18rpx;letter-spacing:4rpx;color:#727b89}.title{font-size:44rpx;font-weight:800;margin-top:6rpx}.hint{font-size:22rpx;color:#8d95a1;margin-top:6rpx}.scene{height:720rpx;margin:0 18rpx;border-radius:32rpx;overflow:hidden;position:relative;border:1rpx solid rgba(255,255,255,.08)}.webgl{width:100%;height:100%}.loading{position:absolute;inset:0;background:#0c0f16;display:flex;align-items:center;justify-content:center;color:#7d8593}.steps{display:flex;justify-content:space-between;padding:22rpx 28rpx 16rpx}.dot{width:92rpx;text-align:center;color:#59616f;font-size:20rpx}.dot>text:first-child{display:flex;width:42rpx;height:42rpx;border-radius:50%;border:1rpx solid #38404c;align-items:center;justify-content:center;margin:0 auto 6rpx}.dot.on{color:#e5aa55}.dot.on>text:first-child{border-color:#e5aa55;background:rgba(229,170,85,.12)}.dot.done{color:#8ca78e}.lab{font-size:18rpx}.controls{padding:4rpx 24rpx calc(22rpx + env(safe-area-inset-bottom))}.choices{display:flex;gap:12rpx;overflow-x:auto}.choice{flex:1;min-width:120rpx;height:100rpx;border-radius:20rpx;background:rgba(255,255,255,.05);border:1rpx solid rgba(255,255,255,.08);display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:20rpx}.choice.on{border-color:#e5aa55;background:rgba(229,170,85,.12)}.action{height:98rpx;border-radius:28rpx;background:linear-gradient(135deg,#e5aa55,#c77731);color:#160f08;font-size:28rpx;font-weight:800;line-height:98rpx}.action::after{border:0}.action[disabled]{opacity:.45}.action.finish{background:linear-gradient(135deg,#74b99b,#4f8c75);color:#07140f}
