/* pages/drink/drink.wxss - 喝酒页面样式 */
.drink-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  position: relative;
  background:
    radial-gradient(ellipse at 50% 35%, rgba(239, 159, 39, 0.08) 0%, transparent 55%),
    radial-gradient(ellipse at 50% 70%, rgba(216, 90, 48, 0.05) 0%, transparent 60%),
    #0f0f1e;
}

/* === 醉酒特效 === */
.drink-page.wobble {
  animation: screenWobble 0.5s infinite ease-in-out;
}

.drink-page.blur .glass-area {
  filter: blur(1px);
}

.drink-page.heavy {
  animation: screenWobble 0.3s infinite ease-in-out;
}

.drink-page.heavy .glass-area {
  filter: blur(2px);
}

.drink-page.heavy .top-bar {
  filter: blur(0.5px);
}

.drink-page.blackout {
  animation: screenBlackout 3s ease-in forwards;
}

@keyframes screenWobble {
  0%, 100% { transform: translate(0, 0) rotate(0deg); }
  25% { transform: translate(-3px, 2px) rotate(-0.5deg); }
  50% { transform: translate(2px, -2px) rotate(0.5deg); }
  75% { transform: translate(-2px, -1px) rotate(-0.3deg); }
}

@keyframes screenBlackout {
  0% { opacity: 1; }
  30% { opacity: 0.7; filter: blur(3px); }
  60% { opacity: 0.4; filter: blur(5px); }
  100% { opacity: 0.15; filter: blur(8px); }
}

/* === 顶部条 === */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
  flex-shrink: 0;
}

.drunk-meter-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.meter-label {
  font-size: 22rpx;
  color: #888;
  flex-shrink: 0;
}

.drunk-meter {
  flex: 1;
  height: 16rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 8rpx;
  overflow: hidden;
}

.drunk-meter-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s ease, background 0.5s ease;
}

.meter-status {
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
  min-width: 80rpx;
  text-align: right;
}

.top-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.sip-counter {
  display: flex;
  align-items: baseline;
}

.sip-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #EF9F27;
}

.sip-unit {
  font-size: 22rpx;
  color: #888;
  margin-left: 4rpx;
}

/* 结束本轮小按钮 - 放在顶部右侧，避免和干一口重叠 */
.btn-finish-mini {
  font-size: 24rpx;
  color: #999;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 28rpx;
  padding: 10rpx 24rpx;
  line-height: 1.4;
}

/* === 骚话气泡 === */
.quote-bubble {
  align-self: center;
  max-width: 80%;
  padding: 16rpx 32rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  opacity: 0;
  transform: translateY(-10rpx) scale(0.9);
  transition: all 0.3s ease;
  margin: 16rpx 0;
  text-align: center;
}

.quote-bubble.show {
  opacity: 1;
  transform: translateY(0) scale(1);
}

.quote-text {
  font-size: 26rpx;
  color: #ccc;
  line-height: 1.5;
}

/* === 酒杯区域 === */
.glass-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  min-height: 0;
}

/* 氛围光晕 */
.glass-glow {
  position: absolute;
  width: 600rpx;
  height: 600rpx;
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
  z-index: 0;
}

.glass-canvas {
  width: 400rpx;
  height: 600rpx;
  position: relative;
  z-index: 1;
}

.drink-name-tag {
  position: relative;
  margin-top: 20rpx;
  padding: 8rpx 24rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  z-index: 1;
}

.drink-name-tag text {
  font-size: 24rpx;
  color: #aaa;
}

/* === 底部按钮区（flex 三栏布局，不再重叠） === */
.action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 40rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.glass-count {
  display: flex;
  align-items: baseline;
  width: 100rpx;
}

.glass-count-placeholder {
  width: 100rpx;
  flex-shrink: 0;
}

.glass-count-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #5DCAA5;
}

.glass-count-label {
  font-size: 22rpx;
  color: #888;
  margin-left: 4rpx;
}

/* 干一口按钮 */
.btn-drink {
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #EF9F27, #D85A30);
  color: #fff;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(239, 159, 39, 0.35),
              inset 0 2rpx 8rpx rgba(255, 255, 255, 0.2);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  position: relative;
}

.btn-drink::after {
  border: none;
}

.btn-drink:active {
  transform: scale(0.92);
  box-shadow: 0 4rpx 16rpx rgba(239, 159, 39, 0.25);
}

.btn-drink.drinking {
  transform: scale(0.88);
  opacity: 0.7;
}

/* 长按豪饮状态 */
.btn-drink.chugging {
  animation: chugPulse 0.3s infinite ease-in-out;
  box-shadow: 0 0 48rpx 16rpx rgba(239, 159, 39, 0.5),
              inset 0 2rpx 8rpx rgba(255, 255, 255, 0.3);
}

@keyframes chugPulse {
  0%, 100% { transform: scale(0.95); }
  50% { transform: scale(1.05); }
}

.btn-drink.disabled {
  background: rgba(255, 255, 255, 0.1);
  box-shadow: none;
  color: #666;
}

.btn-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.btn-text {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
}

.btn-hint {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 8rpx;
}

.btn-drink.disabled .btn-hint {
  display: none;
}

/* 豪饮闪光特效 */
.chug-flash {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 50% 50%, rgba(239, 159, 39, 0.4) 0%, transparent 60%);
  pointer-events: none;
  opacity: 0;
  z-index: 100;
  transition: opacity 0.2s ease;
}

.chug-flash.show {
  opacity: 1;
  animation: flashFade 0.6s ease-out forwards;
}

@keyframes flashFade {
  0% { opacity: 1; }
  100% { opacity: 0; }
}
