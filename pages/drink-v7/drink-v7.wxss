page { background:#0c0d16; }
.v7-page{height:100vh;overflow:hidden;display:flex;flex-direction:column;position:relative;background:radial-gradient(ellipse at 50% 38%,rgba(255,255,255,.035),transparent 48%),linear-gradient(180deg,#11131f 0%,#090a10 100%);color:var(--text-main,#eee)}
.top-bar{display:flex;align-items:center;padding:18rpx 28rpx;padding-top:calc(18rpx + env(safe-area-inset-top));gap:22rpx;z-index:20}.drunk-wrap{display:flex;align-items:center;flex:1;gap:12rpx}.top-label{font-size:21rpx;color:#777}.meter{height:12rpx;flex:1;background:rgba(255,255,255,.08);border-radius:20rpx;overflow:hidden}.meter-fill{height:100%;border-radius:20rpx;transition:width .45s ease}.status{min-width:84rpx;text-align:right;font-size:22rpx;font-weight:650}.finish{font-size:22rpx;color:#999;padding:9rpx 20rpx;border:1rpx solid rgba(255,255,255,.12);border-radius:24rpx;background:rgba(255,255,255,.04)}
.quote{align-self:center;min-height:34rpx;max-width:78%;padding:10rpx 24rpx;margin:2rpx 0 0;border-radius:24rpx;background:rgba(255,255,255,.055);border:1rpx solid rgba(255,255,255,.08);font-size:23rpx;color:#bababa;opacity:0;transform:translateY(-6rpx);transition:.25s;z-index:15}.quote.show{opacity:1;transform:none}
.table-stage{position:relative;flex:1;min-height:0;display:flex;align-items:center;justify-content:center}.ambient{position:absolute;width:620rpx;height:620rpx;border-radius:50%;left:50%;top:45%;transform:translate(-50%,-50%);filter:blur(4rpx);pointer-events:none}.table-shadow{position:absolute;width:520rpx;height:58rpx;left:50%;bottom:58rpx;transform:translateX(-50%);border-radius:50%;background:radial-gradient(ellipse,rgba(0,0,0,.55),transparent 70%)}
.bottle-wrap{position:absolute;left:55rpx;top:48%;width:135rpx;height:330rpx;transform:translateY(-55%) rotate(0deg);transform-origin:56% 22%;transition:transform .35s cubic-bezier(.2,.8,.2,1);z-index:5}.bottle-wrap.pouring{transform:translate(55rpx,-77%) rotate(var(--pour-tilt,62deg))}.bottle{position:relative;width:100%;height:100%;filter:drop-shadow(0 16rpx 18rpx rgba(0,0,0,.35))}.bottle-cap{position:absolute;top:0;left:50%;transform:translateX(-50%);width:50rpx;height:24rpx;border-radius:7rpx 7rpx 3rpx 3rpx;box-shadow:inset 0 3rpx 5rpx rgba(255,255,255,.18)}.bottle-neck{position:absolute;top:21rpx;left:50%;transform:translateX(-50%);width:46rpx;height:85rpx;background:rgba(220,225,215,.22);border-left:2rpx solid rgba(255,255,255,.18);border-right:2rpx solid rgba(255,255,255,.08)}.bottle-body{position:absolute;top:92rpx;left:50%;transform:translateX(-50%);width:118rpx;height:220rpx;border-radius:25rpx 25rpx 16rpx 16rpx;border:2rpx solid rgba(255,255,255,.14);overflow:hidden;box-shadow:inset 13rpx 0 18rpx rgba(255,255,255,.08),inset -15rpx 0 22rpx rgba(0,0,0,.22)}.bottle-highlight{position:absolute;left:14rpx;top:15rpx;width:10rpx;height:155rpx;border-radius:10rpx;background:linear-gradient(180deg,rgba(255,255,255,.28),rgba(255,255,255,.02))}.bottle-label{position:absolute;left:50%;top:90rpx;transform:translateX(-50%);min-width:74rpx;padding:12rpx 8rpx;text-align:center;background:rgba(240,231,210,.85);color:#2e2a25;border-radius:4rpx;font-size:17rpx;font-weight:700;letter-spacing:1rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,.25)}.bottle-beer .bottle-body{border-radius:20rpx 20rpx 13rpx 13rpx}.bottle-whiskey .bottle-body{width:130rpx;height:205rpx;top:106rpx;border-radius:13rpx}.bottle-wine .bottle-body{width:105rpx;height:230rpx;border-radius:32rpx 32rpx 15rpx 15rpx}.bottle-wine .bottle-neck{height:105rpx}.bottle-baijiu .bottle-body,.bottle-erguotou .bottle-body{width:112rpx;height:205rpx;top:105rpx}.stream{position:absolute;left:92rpx;top:24rpx;height:0;border-radius:50%;opacity:0;transform:rotate(7deg);transform-origin:top;box-shadow:0 0 12rpx rgba(255,255,255,.14);transition:opacity .12s}.stream.show{height:330rpx;opacity:.82;animation:streamPulse .18s infinite alternate}@keyframes streamPulse{from{transform:rotate(6deg) scaleX(.82)}to{transform:rotate(8deg) scaleX(1.1)}}
.glass-motion{position:relative;width:350rpx;height:500rpx;z-index:7;transform:translate(48rpx,10rpx) rotate(0);transform-origin:52% 72%;transition:transform .3s ease}.glass-motion.drinking{animation:drinkLift var(--drink-duration,900ms) cubic-bezier(.2,.7,.2,1)}@keyframes drinkLift{0%{transform:translate(48rpx,10rpx) rotate(0)}28%{transform:translate(48rpx,calc(10rpx - var(--lift,100rpx))) rotate(-4deg)}62%{transform:translate(62rpx,calc(4rpx - var(--lift,100rpx))) rotate(var(--drink-rotate,-22deg))}82%{transform:translate(48rpx,calc(10rpx - var(--lift,100rpx))) rotate(-3deg)}100%{transform:translate(48rpx,10rpx) rotate(0)}}.glass-canvas{width:350rpx;height:500rpx}
.drink-title{position:absolute;bottom:74rpx;left:50%;transform:translateX(-40%);display:flex;flex-direction:column;align-items:center;z-index:9}.drink-name{font-size:28rpx;font-weight:700;color:#eee}.serving{font-size:19rpx;color:#777;margin-top:6rpx;white-space:nowrap}
.action-row{display:flex;align-items:center;justify-content:center;gap:26rpx;padding:8rpx 28rpx 14rpx;z-index:20}.counter{width:112rpx;text-align:center;display:flex;align-items:baseline;justify-content:center;flex-wrap:wrap}.counter.right{opacity:.72}.counter-num{font-size:32rpx;font-weight:750;color:var(--accent,#ef9f27)}.counter-unit{font-size:18rpx;color:#777;margin-left:4rpx}.counter-sub{width:100%;font-size:17rpx;color:#555;margin-top:2rpx}.primary{width:250rpx;height:92rpx;border-radius:48rpx;border:0;color:white;font-size:28rpx;font-weight:700;line-height:92rpx;padding:0;background:linear-gradient(135deg,var(--accent,#ef9f27),#d85a30);box-shadow:0 10rpx 30rpx var(--glow,rgba(239,159,39,.25));transition:transform .15s,opacity .15s}.primary::after{border:0}.primary:active{transform:scale(.94)}.primary.disabled{opacity:.45;box-shadow:none}.bartend-btn{background:linear-gradient(135deg,#c95886,#7b4bd4)}.drink-btn.active{transform:scale(.94);opacity:.78}
.wine-drawer{padding:14rpx 0 calc(18rpx + env(safe-area-inset-bottom));background:linear-gradient(180deg,rgba(18,19,28,.65),rgba(7,8,13,.97));border-top:1rpx solid rgba(255,255,255,.07);z-index:25}.drawer-title{display:flex;justify-content:space-between;align-items:center;padding:0 28rpx 10rpx;font-size:21rpx;color:#999}.drawer-tip{font-size:18rpx;color:#565656}.wine-scroll{width:100%;white-space:nowrap}.wine-list{display:flex;gap:12rpx;padding:0 28rpx}.wine-card{width:112rpx;height:105rpx;flex:none;border-radius:17rpx;background:rgba(255,255,255,.045);border:1rpx solid rgba(255,255,255,.07);display:flex;flex-direction:column;align-items:center;justify-content:center;transition:.2s}.wine-card.active{background:var(--accent-light,rgba(239,159,39,.12));border-color:var(--accent,#ef9f27);transform:translateY(-3rpx)}.wine-emoji{font-size:30rpx}.wine-name{font-size:20rpx;color:#ddd;margin-top:3rpx}.wine-abv{font-size:15rpx;color:#666;margin-top:2rpx}
.v7-page.wobble{animation:wobble .55s infinite ease-in-out}.v7-page.blur .table-stage{filter:blur(.7px)}.v7-page.heavy{animation:wobble .32s infinite}.v7-page.heavy .table-stage{filter:blur(1.4px)}.v7-page.blackout{animation:blackout 3s forwards}@keyframes wobble{0%,100%{transform:none}25%{transform:translate(-2rpx,2rpx) rotate(-.25deg)}75%{transform:translate(2rpx,-1rpx) rotate(.25deg)}}@keyframes blackout{to{opacity:.22;filter:blur(5px)}}
